# deploy/.env.example
#
# Copy to deploy/.env before running Compose:  cp .env.example .env
# deploy/.env is ignored by git. This file holds no secrets and is safe to commit.
# Do not put passwords or tokens in either file.

# OpenEMS images, pinned by tag AND index digest (see docs/adr/0003).
# Verified 2026-10-15 with `docker buildx imagetools inspect`: both tags exist for
# linux/amd64 and linux/arm64. To update, follow the procedure in ADR 0003.
OPENEMS_EDGE_IMAGE=openems/edge:2026.9.0@sha256:afd148c64b9d619bd9d2fd34591f9691a0300c1906fb38f808f151fc51cea836
OPENEMS_UI_IMAGE=openems/ui-edge:2026.9.0@sha256:77dc3cc85597715ed8470106d2c752792c37f515a19195dc4ddd4d363e67713e

# Host address the published ports bind to. Keep 127.0.0.1 so nothing is reachable
# from other machines. Change it only after reading ADR 0004.
BIND_ADDRESS=127.0.0.1

# Host ports (container-internal ports are fixed in compose.yaml).
EDGE_FELIX_PORT=8080
UI_HTTP_PORT=8081

# Memory cap for the Edge container. Measured on 2026-10-16 with `docker stats`:
# about 416 MiB in use with the simulated chain running (single snapshot). The Java
# process may size its heap from this cap (from memory, verify), so do not set it
# tight. After changing it, check the container for restarts.
EDGE_MEM_LIMIT=2g

# Container log rotation (json-file driver): size of one log file, and how many
# files are kept. The Edge debug log writes about one line per second.
LOG_MAX_SIZE=10m
LOG_MAX_FILE=3
